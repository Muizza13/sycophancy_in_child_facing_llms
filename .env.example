# Copy to .env and fill in the placeholders. Do not commit .env.
# Future runs start only the models you name. A named model fails if its key is missing.
# Load with: export $(grep -v '^#' .env | xargs)
GOOGLE_API_KEY=
GROQ_API_KEY=
# Optional, only if you name these models on a future run:
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
